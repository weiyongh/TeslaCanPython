* text=auto

# Source, specifications, fixtures, and rendered reports must stay byte-stable.
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf
*.json text eol=lf
*.dbc  text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.kts  text eol=lf
*.xml  text eol=lf
*.properties text eol=lf

# Raw captures and archives are evidence/binary inputs; Git must not normalize them.
*.asc -text
*.zip binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary

# Generated CSV and frozen machine evidence may intentionally retain
# source-produced CRLF bytes. Their SHA can be part of the evidence contract,
# so never normalize them at checkout.
output/**/*.csv -text !eol
output/**/machine_evidence/** -text !eol

# Native Windows launchers retain CRLF.
*.bat text eol=crlf
