CM_ "Experimental receive/decode-only DBC derived from local ASC captures. EXP names are hypotheses, not Tesla definitions. Do not use it to transmit control frames.";
CM_ BO_ 962 "0x3C2 / VCLEFT switch-pack input. LF and LR multiplex-0 fields come from the collected ONYX DBC and were confirmed by physical-button captures.";
CM_ BO_ 1349 "0x545 shared four-window motion feedback candidate. Left-side motion activity is concentrated in Byte 1 bits 1 and 2; right-side activity uses different Byte 2 fields.";
CM_ SG_ 1349 EXP_leftWindowMotionActivityCandidate1 "B1.b1 left-side motion activity candidate. Direction and front/rear allocation are not fully proven.";
CM_ SG_ 1349 EXP_leftWindowMotionActivityCandidate2 "B1.b2 responds in all four scripted LF/LR motion windows and remains unchanged in the no-operation baseline.";
CM_ BO_ 706 "0x2C2 left-side execution/position candidate. In the 20 40 family, Bytes 2-3 track left-front and Bytes 6-7 track left-rear. Stable-window fingerprints reached 100 percent purity in the scripted captures.";
CM_ SG_ 706 EXP_leftMessageFamily_B0_B1 "Observed left execution-position family has B0=0x20, B1=0x40, little-endian raw value 0x4020.";
CM_ SG_ 706 EXP_leftFrontStateOrPosition_B2 "Left-front raw state/position byte; not proven to be a linear position percentage.";
CM_ SG_ 706 EXP_leftFrontPositionOrTarget_B3 "Left-front raw endpoint/target byte.";
CM_ SG_ 706 EXP_leftRearStateOrPosition_B6 "Left-rear raw state/position byte.";
CM_ SG_ 706 EXP_leftRearPositionOrState_B7 "Left-rear raw endpoint/state byte.";
CM_ BO_ 506 "0x1FA whole-vehicle window summary candidate, included here for diagnostic-chain completeness. It is shared by both left and right DBC files.";
CM_ SG_ 506 EXP_anyWindowNotFullyClosedCandidate "B0.b5: 0 with stable payload 02 C0 01 when all windows are closed; 1 with 22 C0 01 when at least one window is not fully closed. Four-window and no-operation validation support about 95 percent semantic confidence.";

VAL_ 962 VCLEFT_btnWindowSwPackUpLF 0 "NOT_ACTIVE" 1 "ACTIVE";
VAL_ 962 VCLEFT_btnWindowSwPackAutoUpLF 0 "NOT_ACTIVE" 1 "ACTIVE";
VAL_ 962 VCLEFT_btnWindowSwPackDownLF 0 "NOT_ACTIVE" 1 "ACTIVE";
VAL_ 962 VCLEFT_btnWindowSwPackAutoDownLF 0 "NOT_ACTIVE" 1 "ACTIVE";
VAL_ 962 VCLEFT_btnWindowSwPackUpLR 0 "NOT_ACTIVE" 1 "ACTIVE";
VAL_ 962 VCLEFT_btnWindowSwPackAutoUpLR 0 "NOT_ACTIVE" 1 "ACTIVE";
VAL_ 962 VCLEFT_btnWindowSwPackDownLR 0 "NOT_ACTIVE" 1 "ACTIVE";
VAL_ 962 VCLEFT_btnWindowSwPackAutoDownLR 0 "NOT_ACTIVE" 1 "ACTIVE";
VAL_ 1349 EXP_leftWindowMotionActivityCandidate1 0 "INACTIVE_CANDIDATE" 1 "ACTIVE_CANDIDATE";
VAL_ 1349 EXP_leftWindowMotionActivityCandidate2 0 "INACTIVE_CANDIDATE" 1 "ACTIVE_CANDIDATE";
VAL_ 506 EXP_anyWindowNotFullyClosedCandidate 0 "ALL_WINDOWS_CLOSED_CANDIDATE" 1 "ANY_WINDOW_NOT_FULLY_CLOSED_CANDIDATE";
